:root {
  --primary: #0e4a72;
  --accent: #ff9352;
  --light: #f4f8fb;
  --dark: #10212f;
  --text-soft: #5c6b79;
  --radius: 16px;
  --shadow: 0 16px 34px rgba(15, 35, 53, 0.14);
  --transition: 0.35s ease;
}

* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

html {
  scroll-behavior: smooth;
}

body {
  font-family: "Poppins", sans-serif;
  color: var(--dark);
  background:
    radial-gradient(circle at 20% 0%, #e9f4ff 0%, transparent 35%),
    radial-gradient(circle at 80% 20%, #fff1e7 0%, transparent 30%),
    linear-gradient(180deg, #ffffff, #f3f7fa);
}

h1,
h2,
h3,
h4 {
  font-family: "Playfair Display", serif;
  font-weight: 600;
  letter-spacing: 0.2px;
}

img {
  max-width: 100%;
  display: block;
}

a {
  text-decoration: none;
}

.container {
  width: min(1200px, 92%);
  margin: 0 auto;
}

.section {
  padding: 80px 0;
}

.section-soft {
  background: linear-gradient(180deg, #f8fbfe, var(--light));
}

.section-dark {
  background: linear-gradient(120deg, #0d2a42, #11486a);
  color: #fff;
}

.site-header {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  z-index: 200;
  background: rgba(8, 34, 52, 0.32);
  border-bottom: 1px solid rgba(255, 255, 255, 0.16);
  backdrop-filter: blur(10px);
  transition: background var(--transition);
}

.site-header.scrolled {
  background: linear-gradient(90deg, rgba(11, 47, 73, 0.96), rgba(17, 78, 114, 0.94));
}

.nav-wrap {
  height: 82px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
}

.logo {
  color: #fff;
  font-family: "Playfair Display", serif;
  font-size: 26px;
}

.nav-links {
  list-style: none;
  display: flex;
  gap: 18px;
  flex-wrap: wrap;
}

.nav-links a {
  color: #fff;
  font-size: 14px;
  letter-spacing: 0.5px;
  text-transform: uppercase;
  border-bottom: 2px solid transparent;
  padding-bottom: 3px;
  transition: color var(--transition), border-color var(--transition);
}

.nav-links a:hover,
.nav-links .active {
  color: var(--accent);
  border-color: var(--accent);
}

.hero {
  min-height: 100vh;
  position: relative;
  display: flex;
  align-items: center;
  padding-top: 82px;
  background-size: cover;
  background-position: center;
}

.hero-home {
  background-image: url("../images/hero.jpg");
  background-attachment: fixed;
}

.hero-overlay,
.banner-overlay {
  position: absolute;
  inset: 0;
  background: linear-gradient(135deg, rgba(6, 20, 30, 0.82), rgba(16, 58, 85, 0.42));
}

.hero-content,
.banner-content {
  position: relative;
  z-index: 2;
  color: #fff;
}

.hero-content {
  max-width: 780px;
  animation: fadeUp 1.2s ease forwards;
  opacity: 0;
}

.hero-kicker {
  letter-spacing: 2px;
  text-transform: uppercase;
  font-size: 13px;
  margin-bottom: 14px;
}

.hero-title {
  font-size: clamp(46px, 6vw, 76px);
  line-height: 1.05;
  margin-bottom: 18px;
}

.hero-subtitle {
  max-width: 640px;
  margin-bottom: 30px;
  font-size: 18px;
}

.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  border: 0;
  cursor: pointer;
  padding: 12px 24px;
  border-radius: 999px;
  transition: all var(--transition);
}

.btn-primary {
  background: linear-gradient(135deg, #ff9352, #ff7b35);
  color: #fff;
  box-shadow: 0 12px 24px rgba(255, 123, 53, 0.35);
}

.btn-primary:hover {
  transform: translateY(-3px);
  box-shadow: 0 16px 28px rgba(255, 123, 53, 0.52);
}

.btn-outline {
  color: #fff;
  border: 1px solid rgba(255, 255, 255, 0.75);
}

.btn-outline:hover {
  color: #fff;
  background: rgba(255, 147, 82, 0.18);
  border-color: var(--accent);
}

.section-head {
  margin-bottom: 28px;
}

.section-head h2 {
  font-size: clamp(32px, 4vw, 46px);
}

.section-head .label {
  color: var(--accent);
  text-transform: uppercase;
  letter-spacing: 2px;
  font-size: 12px;
  margin-bottom: 8px;
}

.section-head-light .label {
  color: #d9b787;
}

.about-grid,
.card-grid,
.footer-grid,
.booking-layout,
.contact-layout {
  display: grid;
  gap: 22px;
}

.about-grid,
.card-grid-3 {
  grid-template-columns: repeat(3, minmax(0, 1fr));
}

.card-grid-4 {
  grid-template-columns: repeat(4, minmax(0, 1fr));
}

.info-card,
.room-card,
.menu-card,
.activity-card,
.review-card,
.contact-card,
.price-box,
.booking-form,
.gallery-item,
.testimonial-slide {
  background: #fff;
  border: 1px solid rgba(14, 74, 114, 0.08);
  border-radius: var(--radius);
  box-shadow: var(--shadow);
}

.info-card,
.contact-card,
.menu-card,
.activity-card,
.review-card,
.testimonial-slide {
  padding: 24px;
}

.info-card p,
.room-meta,
.room-description,
.menu-card p,
.activity-card p,
.contact-card p {
  color: var(--text-soft);
}

.room-card {
  overflow: hidden;
  transition: transform var(--transition), box-shadow var(--transition);
}

.room-card:hover {
  transform: translateY(-8px);
  box-shadow: 0 24px 42px rgba(13, 45, 68, 0.2);
}

.room-image-wrap {
  overflow: hidden;
}

.room-image-wrap img {
  width: 100%;
  height: 230px;
  object-fit: cover;
  transition: transform 0.5s ease;
}

.room-card:hover .room-image-wrap img {
  transform: scale(1.08);
}

.room-content {
  padding: 20px;
}

.room-content h3 {
  margin-bottom: 8px;
}

.room-meta {
  font-size: 14px;
  margin-bottom: 8px;
}

.room-price {
  margin: 8px 0;
  font-weight: 700;
  color: #e46f2d;
}

.amenity-tags {
  list-style: none;
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
  margin-bottom: 14px;
}

.amenity-tags li {
  background: #eaf2f8;
  border-radius: 999px;
  padding: 5px 10px;
  font-size: 12px;
  color: #25465f;
}

.slider-shell {
  overflow: hidden;
  border-radius: var(--radius);
  box-shadow: var(--shadow);
}

.horizontal-track {
  display: flex;
  gap: 16px;
  padding: 8px;
  overflow-x: auto;
  scroll-behavior: smooth;
}

.horizontal-track::-webkit-scrollbar {
  height: 8px;
}

.horizontal-track::-webkit-scrollbar-thumb {
  background: #cfd8dc;
  border-radius: 999px;
}

.preview-card {
  min-width: 280px;
  background: linear-gradient(180deg, #ffffff, #fbfdff);
  border: 1px solid rgba(14, 74, 114, 0.08);
  border-radius: 12px;
  overflow: hidden;
}

.preview-card img {
  width: 100%;
  height: 170px;
  object-fit: cover;
}

.preview-card .preview-body {
  padding: 14px;
}

.activity-card img,
.menu-card img {
  width: 100%;
  height: 190px;
  object-fit: cover;
  border-radius: 12px;
  margin-bottom: 12px;
}

.activity-card button {
  margin-top: 10px;
}

.page-banner {
  min-height: 54vh;
  position: relative;
  display: grid;
  place-items: center;
  padding-top: 82px;
  background-size: cover;
  background-position: center;
}

.rooms-banner {
  background-image: url("../images/villa.jpg");
}

.dining-banner {
  background-image: url("../images/seafood-platter.jpg");
}

.activities-banner {
  background-image: url("../images/water_sports.jpg");
}

.gallery-banner {
  background-image: url("../images/gallery2.jpg");
}

.booking-banner {
  background-image: url("../images/pool.jpg");
}

.contact-banner {
  background-image: url("../images/spa.jpg");
}

.dashboard-banner {
  background-image: url("../images/conference-hall.jpg");
}

.banner-content h1 {
  font-size: clamp(36px, 5vw, 62px);
  margin-bottom: 10px;
}

.testimonial-slider {
  min-height: 180px;
}

.testimonial-slide {
  color: #111;
  max-width: 760px;
  margin: 0 auto;
  text-align: center;
}

.testimonial-slide p {
  color: #3e4b56;
}

.testimonial-author {
  margin-top: 14px;
  font-weight: 600;
  color: var(--primary);
}

.cta-box {
  text-align: center;
  background: #fff;
  border-radius: 24px;
  padding: 40px 24px;
  box-shadow: var(--shadow);
}

.cta-box p {
  margin: 12px 0 20px;
  color: var(--text-soft);
}

.rooms-filter {
  background: linear-gradient(180deg, #ffffff, #f7fbfe);
  border: 1px solid #d8e5ef;
  border-radius: 14px;
  padding: 16px;
  margin-bottom: 22px;
}

.rooms-filter label {
  display: block;
  font-size: 14px;
  color: #1e415a;
  margin-bottom: 10px;
}

.rooms-filter-controls {
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
}

.rooms-filter input {
  flex: 1 1 220px;
  min-width: 200px;
  border: 1px solid #c9d9e6;
  border-radius: 10px;
  padding: 10px 12px;
  font: inherit;
}



.rooms-filter input:focus,
.booking-form input:focus,
.booking-form select:focus,
.contact-form input:focus,
.contact-form textarea:focus {
  border-color: #ff9352;
  box-shadow: 0 0 0 3px rgba(255, 147, 82, 0.2);
  outline: none;
}


.rooms-filter .btn-outline {
  color: var(--primary);
  border: 1px solid #c9d9e6;
}

.rooms-filter .btn-outline:hover {
  color: #fff;
  background: var(--primary);
  border-color: var(--primary);
}

.rooms-filter-summary {
  margin-top: 10px;
  color: var(--text-soft);
  font-size: 14px;
}
.filter-bar {
  display: flex;
  gap: 10px;
  margin-bottom: 24px;
  flex-wrap: wrap;
}

.filter-btn {
  border: 1px solid #c9d9e6;
  background: #fff;
  color: #21445d;
  padding: 8px 16px;
  border-radius: 999px;
  cursor: pointer;
  transition: all var(--transition);
}

.filter-btn.active,
.filter-btn:hover {
  background: linear-gradient(135deg, #0f4f79, #12608f);
  color: #fff;
  border-color: #12608f;
}

.gallery-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 14px;
}

.gallery-item {
  overflow: hidden;
}

.gallery-item img {
  width: 100%;
  height: 220px;
  object-fit: cover;
  transition: transform var(--transition);
}

.gallery-item:hover img {
  transform: scale(1.08);
}

.booking-layout {
  grid-template-columns: 2fr 1fr;
  align-items: start;
}

.booking-form {
  padding: 26px;
}

.booking-form h2 {
  margin-bottom: 18px;
}

.form-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 14px;
}

.booking-form label,
.contact-form label {
  display: flex;
  flex-direction: column;
  gap: 8px;
  font-size: 14px;
}

.booking-form input,
.booking-form select,
.contact-form input,
.contact-form textarea {
  border: 1px solid #d3dbe2;
  border-radius: 10px;
  padding: 10px 12px;
  font: inherit;
}

.form-message {
  margin: 12px 0;
  color: #b42318;
  min-height: 22px;
}

.price-box {
  padding: 26px;
}

.price-box h3 {
  margin-bottom: 16px;
}

.price-line {
  display: flex;
  justify-content: space-between;
  padding: 10px 0;
  border-bottom: 1px solid #e9eff4;
}

.total-line {
  border-bottom: 0;
  margin-top: 8px;
  font-size: 18px;
  color: var(--primary);
}

.contact-layout {
  grid-template-columns: 1fr 1fr;
}

.dashboard-kpi-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 14px;
}

.kpi-card {
  padding: 18px 20px;
  background: linear-gradient(180deg, #ffffff, #f7fbff);
  border: 1px solid rgba(14, 74, 114, 0.08);
  border-radius: 14px;
  box-shadow: var(--shadow);
}

.kpi-card p {
  color: var(--text-soft);
  font-size: 14px;
}

.kpi-card h3 {
  font-size: 34px;
  margin-top: 8px;
}

.dashboard-layout {
  display: grid;
  grid-template-columns: 1.5fr 1fr;
  gap: 22px;
  align-items: start;
}

.dashboard-panel {
  background: #fff;
  border: 1px solid rgba(14, 74, 114, 0.08);
  border-radius: var(--radius);
  box-shadow: var(--shadow);
  padding: 20px;
}

.dashboard-panel-head {
  margin-bottom: 14px;
}

.dashboard-panel canvas {
  width: 100%;
  border: 1px solid #e2edf6;
  border-radius: 12px;
  background: #fbfdff;
}

.dashboard-form {
  display: grid;
  gap: 12px;
}

.dashboard-form label {
  display: flex;
  flex-direction: column;
  gap: 8px;
  font-size: 14px;
}

.dashboard-form input,
.dashboard-form select,
.dashboard-toolbar input,
.dashboard-toolbar select {
  border: 1px solid #d3dbe2;
  border-radius: 10px;
  padding: 10px 12px;
  font: inherit;
}

.dashboard-form input:focus,
.dashboard-form select:focus,
.dashboard-toolbar input:focus,
.dashboard-toolbar select:focus {
  border-color: #ff9352;
  box-shadow: 0 0 0 3px rgba(255, 147, 82, 0.2);
  outline: none;
}

.dashboard-toolbar {
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
  margin-bottom: 16px;
}

.dashboard-toolbar input,
.dashboard-toolbar select {
  flex: 1 1 220px;
}

.dashboard-toolbar .btn-outline {
  color: var(--primary);
  border: 1px solid #c9d9e6;
}

.dashboard-toolbar .btn-outline:hover {
  color: #fff;
  background: var(--primary);
  border-color: var(--primary);
}

.dashboard-table-wrap {
  overflow-x: auto;
  border: 1px solid #d6e4ef;
  border-radius: 12px;
  background: #fff;
}

.dashboard-table {
  width: 100%;
  border-collapse: collapse;
  min-width: 760px;
}

.dashboard-table th,
.dashboard-table td {
  text-align: left;
  padding: 12px 14px;
  border-bottom: 1px solid #edf2f6;
  font-size: 14px;
}

.dashboard-table th {
  background: #f7fbff;
  color: #1c4059;
  font-weight: 600;
}

.dashboard-table tbody tr:hover {
  background: #fafdff;
}

.status-chip {
  display: inline-block;
  border-radius: 999px;
  padding: 4px 10px;
  font-size: 12px;
  font-weight: 600;
}

.status-confirmed {
  background: #e8f8ee;
  color: #166534;
}

.status-pending {
  background: #fff6df;
  color: #92400e;
}

.status-checked-in {
  background: #e8f2ff;
  color: #1d4ed8;
}

.table-action-btn {
  border: 1px solid #d5e1eb;
  border-radius: 8px;
  background: #fff;
  color: #224760;
  padding: 6px 10px;
  font-size: 12px;
  cursor: pointer;
}

.table-action-btn:hover {
  background: #f2f8fd;
}

.contact-card img {
  margin-top: 16px;
  height: 220px;
  width: 100%;
  object-fit: cover;
  border-radius: 12px;
}

.site-footer {
  background: linear-gradient(120deg, #0a2133, #0f3f61);
  color: #fff;
  padding-top: 32px;
  border-top: 4px solid rgba(255, 147, 82, 0.72);
}

.footer-grid {
  grid-template-columns: 1fr 1fr;
  padding-bottom: 20px;
}

.copyright {
  text-align: center;
  color: #c5d2dc;
  font-size: 13px;
  padding: 14px 0 20px;
  border-top: 1px solid rgba(255, 255, 255, 0.1);
}

.modal {
  position: fixed;
  inset: 0;
  background: rgba(5, 21, 31, 0.66);
  display: none;
  align-items: center;
  justify-content: center;
  z-index: 400;
  padding: 20px;
}

.modal.show {
  display: flex;
}

.modal-panel {
  width: min(540px, 100%);
  max-height: 90vh;
  overflow-y: auto;
  background: #fff;
  border-radius: 14px;
  padding: 22px;
  position: relative;
}

.modal-panel img {
  width: 100%;
  height: 220px;
  object-fit: cover;
  border-radius: 12px;
  margin-bottom: 12px;
}

.modal-close {
  position: absolute;
  right: 14px;
  top: 14px;
  border: 0;
  background: #eef5fb;
  color: #234661;
  border-radius: 50%;
  width: 30px;
  height: 30px;
  cursor: pointer;
}



.reveal {
  opacity: 0;
  transform: translateY(24px);
  transition: opacity 0.8s ease, transform 0.8s ease;
}

.reveal.visible {
  opacity: 1;
  transform: translateY(0);
}

@keyframes fadeUp {
  from {
    opacity: 0;
    transform: translateY(28px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@media (max-width: 1200px) {
  .card-grid-4 {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
  .gallery-grid {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }
  .dashboard-kpi-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
}

@media (max-width: 900px) {
  .about-grid,
  .card-grid-3,
  .booking-layout,
  .contact-layout,
  .dashboard-layout,
  .footer-grid,
  .gallery-grid {
    grid-template-columns: 1fr;
  }
  .form-grid {
    grid-template-columns: 1fr;
  }
  .nav-wrap {
    height: auto;
    padding: 12px 0;
    flex-direction: column;
    align-items: flex-start;
  }
  .site-header {
    position: static;
  }
  .hero,
  .page-banner {
    padding-top: 30px;
  }
  .hero-home {
    background-attachment: scroll;
  }
}




